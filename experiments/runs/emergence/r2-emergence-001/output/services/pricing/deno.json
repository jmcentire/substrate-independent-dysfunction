{
  "name": "pricing-service",
  "version": "1.0.0",
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read src/main.ts",
    "dev": "deno run --watch --allow-net --allow-env --allow-read src/main.ts",
    "test": "deno test --allow-net --allow-env --allow-read tests/ --unstable",
    "test:unit": "deno test --allow-net --allow-env --allow-read tests/unit/ --unstable",
    "test:integration": "deno test --allow-net --allow-env --allow-read tests/integration/ --unstable"
  },
  "imports": {
    "oak": "https://deno.land/x/oak@v12.6.1/mod.ts",
    "postgres": "https://deno.land/x/postgres@v0.17.0/mod.ts",
    "redis": "https://deno.land/x/redis@v0.31.0/mod.ts",
    "zod": "https://deno.land/x/zod@v3.22.4/mod.ts",
    "asserts": "https://deno.land/std@0.208.0/assert/mod.ts",
    "uuid": "https://deno.land/std@0.208.0/uuid/mod.ts",
    "dotenv": "https://deno.land/std@0.208.0/dotenv/mod.ts",
    "log": "https://deno.land/std@0.208.0/log/mod.ts",
    "datetime": "https://deno.land/std@0.208.0/datetime/mod.ts"
  }
}
